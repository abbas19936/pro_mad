<script>
    function showSummary(summary_ar, summary_en) {
        document.getElementById('summary_ar_content').textContent = summary_ar || 'غير متوفر';
        document.getElementById('summary_en_content').textContent = summary_en || 'Not available';
        var myModal = new bootstrap.Modal(document.getElementById('summaryModal'));
        myModal.show();
    }

    function updateDateTime() {
        var now = new Date();
        var dateOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        document.getElementById('dateText').textContent = now.toLocaleDateString('ar-EG', dateOptions);
        document.getElementById('timeText').textContent = now.toLocaleTimeString('ar-EG', { hour12: false });
    }
    
    // البحث الفوري عن المشاريع
    document.getElementById('searchInput').addEventListener('input', function() {
        const searchTerm = this.value.trim().toLowerCase();
        const projectCards = document.querySelectorAll('.project-card');
        let visibleCount = 0;
        
        projectCards.forEach(card => {
            const title = card.getAttribute('data-title').toLowerCase();
            const author = card.getAttribute('data-author').toLowerCase();
            const supervisor = card.getAttribute('data-supervisor').toLowerCase();
            
            if (title.includes(searchTerm) || author.includes(searchTerm) || supervisor.includes(searchTerm) || searchTerm === '') {
                card.style.display = '';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });
        
        // إذا لم توجد نتائج
        let noResultsDiv = document.getElementById('noResults');
        if (visibleCount === 0 && searchTerm !== '') {
            if (!noResultsDiv) {
                noResultsDiv = document.createElement('div');
                noResultsDiv.id = 'noResults';
                noResultsDiv.className = 'no-projects';
                noResultsDiv.textContent = 'لم يتم العثور على نتائج للبحث';
                document.querySelector('.projects-grid').appendChild(noResultsDiv);
            }
        } else if (noResultsDiv) {
            noResultsDiv.remove();
        }
    });
    
    document.addEventListener('DOMContentLoaded', function() {
        updateDateTime();
        setInterval(updateDateTime, 1000);
    });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<?php if($showProfileModal): ?>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        new bootstrap.Modal(document.getElementById('profileModal')).show();
    });
</script>
<?php endif; ?>
</body>
</html>
