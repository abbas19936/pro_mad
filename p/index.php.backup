<script>
function toggleAuthor2() {
    const checkbox = document.getElementById('add_author2');
    const input = document.getElementById('author2');
    input.style.display = checkbox.checked ? 'block' : 'none';
    if (!checkbox.checked) input.value = '';
}
function toggleAuthor3() {
    const checkbox = document.getElementById('add_author3');
    const input = document.getElementById('author3');
    input.style.display = checkbox.checked ? 'block' : 'none';
    if (!checkbox.checked) input.value = '';
}
</script>

