                flex: 1;
                min-width: auto;
            }
            .action-tabs .btn {
                min-width: auto;
                width: 100%;
            }
            .table-responsive {
                font-size: 0.85rem;
            }
            /* تحويل الجدول إلى بطاقات - المحمول فقط */
            .table, .table thead, .table tbody, .table th, .table td, .table tr {
                display: block;
                width: 100%;
            }
            .table thead tr {
                position: absolute;
                top: -9999px;
                left: -9999px;
            }
            .table tbody {
                display: grid;
                grid-template-columns: 1fr;
                gap: 18px;
                width: 100%;
            }
            .table tbody tr {
                display: contents;
            }
            .table td {
                display: block;
                padding: 0 !important;
                width: 100%;
            }
            .table td:before {
                display: none !important;
            }
            /* تحسينات البطاقة - توسيع وتوسيط */
            .table tbody > tr > td {
                min-height: auto;
                display: flex;
                flex-direction: column;
                background: #f9fbff;
                border: 1px solid rgba(0,145,255,0.16);
                border-radius: 16px;
                box-shadow: 0 8px 22px rgba(0,0,0,0.06);
            }
            .table tbody > tr > td > div:first-child {
                /* عنوان البطاقة */
                text-align: center;
                padding: 18px 16px;
                background: #ffffff;
                border-bottom: 1px solid rgba(0,145,255,0.14);
                color: #0b3a66;
            }
            .table tbody > tr > td > div:last-child {
                /* محتوى البطاقة */
                flex: 1;
                display: grid;
                grid-template-columns: 1fr;
                gap: 10px;
                width: 100%;
                padding: 8px 0 16px;
            }
            .table tbody > tr > td > div:last-child > div {
                padding: 14px 16px !important;
                text-align: center;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                border-bottom: 1px solid #e9eff9;
                border-left: none;
            }
            .table tbody > tr > td > div:last-child > div:last-child {
                border-bottom: none;
            }
            .table tbody > tr > td > div:last-child > div .badge {
                background: #d5edff;
                color: #005caa;
            }
            .modal-dialog {
                margin: 10px;
            }
            .modal-body {
                padding: 15px;
            }
        }

        @media (max-width: 576px) {
            .college-header h2 {
                font-size: 1rem;
            }
            .college-header p {
                font-size: 0.85rem;
            }
            .table tr {
                margin-bottom: 12px;
            }
            .table td {
