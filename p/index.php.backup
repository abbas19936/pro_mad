    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { 
            background: linear-gradient(165deg, #eaf4ff 0%, #ffffff 100%);
            min-height: 100vh; 
            font-family: 'Cairo', sans-serif;
            color: #102a43;
        }
        .college-header { 
            background: rgba(255,255,255,0.98); 
            padding: 30px; 
            text-align: center; 
            border-bottom: 5px solid #0091ff; 
            border-radius: 15px; 
            margin-bottom: 30px; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.12);
            animation: fadeInDown 0.8s ease-out;
        }
        .college-logo { 
            max-height: 120px; 
            animation: fadeIn 1s ease-out;
        }
        .datetime { 
            font-size: 1.2em; 
            color: #1f3a55; 
            margin-top: 15px; 
            animation: fadeIn 1.2s ease-out;
        }
        .feature-cards {
            gap: 18px;
            margin-bottom: 30px;
        }
        .feature-card {
            background: rgba(255,255,255,0.95);
            border: 1px solid rgba(0,0,0,0.08);
            border-radius: 18px;
            padding: 22px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            min-height: 170px;
        }
        .feature-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 45px rgba(0,0,0,0.12);
        }
        .feature-card-icon {
            width: 58px;
            height: 58px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.7rem;
            border-radius: 16px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
            margin-bottom: 15px;
        }
        .feature-card-title {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 10px;
        }
        .feature-card-text {
            color: #5a5a5a;
            line-height: 1.8;
            font-size: 0.98rem;
        }
        .projects-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(360px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        .project-card {
            background: #ffffff;
            border: 1px solid rgba(0,0,0,0.08);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 14px 35px rgba(0,0,0,0.08);
            transition: transform 0.25s ease, box-shadow 0.25s ease;
            display: flex;
            flex-direction: column;
        }
        .project-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 45px rgba(0,0,0,0.14);
        }
        .project-card-header {
            background: linear-gradient(135deg, #007bff, #0056b3);
            color: #fff;
            padding: 18px 16px;
            font-size: 1.15rem;
            font-weight: 700;
            text-align: center;
        }
        .project-card-body {
            display: flex;
            flex-direction: row;
            min-height: 360px;
        }
        .project-details,
        .project-preview {
            padding: 18px 16px;
        }
        .project-details {
            width: 50%;
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
        }
        .project-preview {
            width: 50%;
            border-left: 1px solid rgba(0,0,0,0.08);
            display: flex;
            flex-direction: column;
            gap: 14px;
            justify-content: space-between;
        }
        .project-info-item {
            background: #f4f8ff;
            border: 1px solid rgba(0,123,255,0.14);
            border-radius: 16px;
            padding: 14px 12px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 6px;
        }
        .project-info-item strong {
            color: #007bff;
            font-size: 0.95rem;
        }
        .project-info-item span {
            color: #333;
            font-size: 0.95rem;
        }
        .project-preview iframe {
            width: 100%;
            height: 320px;
            border: 1px solid rgba(0,0,0,0.08);
            border-radius: 16px;
            background: #fff;
        }
        .project-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-items: center;
            justify-content: center;
        }
        .project-actions .btn {
            min-width: 160px;
        }
        .project-search {
            width: 100%;
            max-width: 420px;
        }
        .project-search input {
            width: 100%;
            border: 2px solid #007bff;
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 1rem;
            transition: border-color 0.25s ease, box-shadow 0.25s ease;
        }
        .project-search input:focus {
            outline: none;
            border-color: #0056b3;
            box-shadow: 0 0 12px rgba(0,86,179,0.18);
        }
        .container, .container-fluid { 
            width: 100%;
            max-width: none;
            background: white; 
            padding: 30px 15px; 
            border-radius: 0; 
            box-shadow: 0 15px 35px rgba(0,0,0,0.1); 
            animation: fadeInUp 1s ease-out;
        }
        .table-responsive,
        .table,
        .table tbody,
        .table tbody tr,
        .table tbody tr > td {
            width: 100% !important;
            max-width: 100% !important;
        }
        .table tbody tr > td {
            margin: 0;
            box-sizing: border-box;
        }
        .btn-custom { 
            background: linear-gradient(45deg, #007bff, #0056b3); 
            border: none; 
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0,123,255,0.3);
        }
        .action-tabs {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            flex-wrap: nowrap;
            gap: 8px;
            overflow-x: auto;
            padding-top: 5px;
            width: 100%;
        }
        .action-tabs .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            white-space: nowrap;
            min-width: 110px;
            padding: 8px 14px;
            font-size: 0.95rem;
        }
        @media (max-width: 992px) {
            .action-tabs {
                justify-content: flex-start;
            }
        }
        .no-cover {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 260px;
            background: #f4f8ff;
            color: #5a5a5a;
            border: 1px dashed rgba(0,0,0,0.15);
            border-radius: 16px;
            font-size: 0.95rem;
            padding: 20px;
            text-align: center;
        }
        .project-card[data-hidden="true"] {
            display: none !important;
        }
        .table tr { 
            transition: all 0.3s ease; 
        }
        .table tr:hover { 
            background-color: rgba(0,123,255,0.1) !important; 
            transform: scale(1.02); 
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        .table td { 
            padding: 12px; 
            vertical-align: middle; 
        }
        .table { 
            animation: fadeIn 1.5s ease-out; 
        }
        .badge { 
            animation: pulse 2s infinite; 
        }
        .table tbody {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }
        .table tbody tr {
            display: contents;
        }
        .table tbody > tr > td {
            width: 100% !important;
            display: block;
        }
        @keyframes fadeInDown {
            from { opacity: 0; transform: translateY(-30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes bounceIn {
            0% { opacity: 0; transform: scale(0.3); }
            50% { opacity: 1; transform: scale(1.05); }
            70% { transform: scale(0.9); }
            100% { opacity: 1; transform: scale(1); }
        }

        /* Responsive Styles */
        @media (max-width: 768px) {
            body {
                font-size: 14px;
            }
            .college-header {
                padding: 15px;
            }
            .college-logo {
