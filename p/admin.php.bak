        $file_name = $_FILES['pdf']['name'];
        move_uploaded_file($_FILES['pdf']['tmp_name'], "uploads/".$file_name);
    }
    
    $sql = "INSERT INTO books (title, author, supervisor_name, specialty, project_idea, summary_ar, summary_en, beneficiary, pdf_file, publication_date, added_by) 
            VALUES ('$title', '$author', '$supervisor_name', '$spec', '$project_idea', '$summary_ar', '$summary_en', '$beneficiary', '$file_name', '$pub_date', 1)"; // 1 for admin
    mysqli_query($conn, $sql);
    echo "<script>alert('تم إضافة المشروع بنجاح');</script>";
}

