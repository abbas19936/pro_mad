                            <label class="form-label">ÙÙƒØ±Ø© Ø§Ù„Ù…Ø´Ø±ÙˆØ¹</label>
                            <textarea name="edit_project_idea" id="edit_project_idea" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">ملخص المشروع بالعربية</label>
                            <textarea name="edit_summary_ar" id="edit_summary_ar" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">ملخص المشروع بالإنجليزية</label>
                            <textarea name="edit_summary_en" id="edit_summary_en" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">الجهة المستفيدة من المشروع</label>
                            <input type="text" name="edit_beneficiary" id="edit_beneficiary" class="form-control">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Ø¥Ù„ØºØ§Ø¡</button>
                        <button type="submit" name="edit_book" class="btn btn-primary">Ø­ÙØ¸ Ø§Ù„ØªØºÙŠÙŠØ±Ø§Øª</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Ù„ØªØ¹Ø¯ÙŠÙ„ ÙƒÙ„Ù…Ø© Ø§Ù„Ù…Ø±ÙˆØ± -->
    <div class="modal fade" id="editPasswordModal" tabindex="-1" aria-labelledby="editPasswordModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editPasswordModalLabel">ØªØ¹Ø¯ÙŠÙ„ ÙƒÙ„Ù…Ø© Ø§Ù„Ù…Ø±ÙˆØ±</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="POST">
                    <div class="modal-body">
                        <input type="hidden" name="edit_user_id" id="edit_user_id">
                        <div class="mb-3">
                            <label class="form-label">Ø§Ù„Ø£Ø³ØªØ§Ø°: <span id="edit_user_name"></span></label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">ÙƒÙ„Ù…Ø© Ø§Ù„Ù…Ø±ÙˆØ± Ø§Ù„Ø¬Ø¯ÙŠØ¯Ø©</label>
                            <input type="password" name="new_password" class="form-control" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Ø¥Ù„ØºØ§Ø¡</button>
                        <button type="submit" name="edit_password" class="btn btn-primary">Ø­ÙØ¸</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        function editBook(id, title, author, supervisor, specialty, pub_date, project_idea, summary_ar, summary_en, beneficiary) {
            document.getElementById('edit_id').value = id;
            document.getElementById('edit_title').value = title;
            document.getElementById('edit_author').value = author;
            document.getElementById('edit_supervisor_name').value = supervisor;
            document.getElementById('edit_specialty').value = specialty;
            document.getElementById('edit_pub_date').value = pub_date;
            document.getElementById('edit_project_idea').value = project_idea;
            document.getElementById('edit_summary_ar').value = summary_ar;
            document.getElementById('edit_summary_en').value = summary_en;
            document.getElementById('edit_beneficiary').value = beneficiary;
        }
        function showSummary(summary_ar, summary_en) {
            document.getElementById('summary_ar_content').textContent = summary_ar || 'غير متوفر';
            document.getElementById('summary_en_content').textContent = summary_en || 'غير متوفر';
            var myModal = new bootstrap.Modal(document.getElementById('summaryModal'));
            myModal.show();
        }
        function editPassword(id, name) {
            document.getElementById('edit_user_id').value = id;
            document.getElementById('edit_user_name').textContent = name;
        }
    </script>

    <!-- Modal لعرض الملخص -->
    <div class="modal fade" id="summaryModal" tabindex="-1" aria-labelledby="summaryModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="summaryModalLabel">ملخص المشروع</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <h6>الملخص بالعربية:</h6>
                    <p id="summary_ar_content"></p>
                    <hr>
                    <h6>الملخص بالإنجليزية:</h6>
                    <p id="summary_en_content"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>




