// Ø¯Ø§Ù„Ø© Ù„Ø¥Ø±Ø³Ø§Ù„ Ø¥Ø´Ø¹Ø§Ø±
function send_notification($student_email, $message, $type = 'info') {
    global $conn;
    $email = mysqli_real_escape_string($conn, $student_email);
    $result = mysqli_query($conn, "SELECT id FROM students WHERE email = '$email'");
    if($result && mysqli_num_rows($result) == 1) {
        $row = mysqli_fetch_assoc($result);
        $student_id = $row['id'];
        $message = mysqli_real_escape_string($conn, $message);
        mysqli_query($conn, "INSERT INTO notifications (student_id, message, type) VALUES ($student_id, '$message', '$type')");
    }
}

if(isset($_GET['approve_request'])) {
    $id = intval($_GET['approve_request']);
    $result = mysqli_query($conn, "SELECT * FROM requests WHERE id = $id");
    if($result && $row = mysqli_fetch_assoc($result)) {
        // Ø£Ø¶Ù Ø§Ù„ÙƒØªØ§Ø¨ Ø¥Ù„Ù‰ Ø¬Ø¯ÙˆÙ„ books (Ø§ÙØªØ±Ø§Ø¶ÙŠØ§Ù‹ Ø¨Ø¯ÙˆÙ† PDFØŒ ÙŠÙ…ÙƒÙ† ØªØ­Ø¯ÙŠØ« Ù„Ø§Ø­Ù‚Ø§Ù‹)
        $title = mysqli_real_escape_string($conn, $row['book_title']);
        $author = 'ØºÙŠØ± Ù…Ø­Ø¯Ø¯'; // ÙŠÙ…ÙƒÙ† ØªØ­Ø¯ÙŠØ«
        $specialty = mysqli_real_escape_string($conn, $row['specialty']);
        $sql = "INSERT INTO books (title, author, specialty, pdf_file, external_link) 
                VALUES ('$title', '$author', '$specialty', '', '')";
        mysqli_query($conn, $sql);
        
        // Ø£Ø±Ø³Ù„ Ø¥Ø´Ø¹Ø§Ø±
        send_notification($row['email'], "ØªÙ…Øª Ø§Ù„Ù…ÙˆØ§ÙÙ‚Ø© Ø¹Ù„Ù‰ Ø·Ù„Ø¨Ùƒ Ù„Ù„ÙƒØªØ§Ø¨: {$row['book_title']}. Ø§Ù„ÙƒØªØ§Ø¨ Ù…ØªØ§Ø­ Ø§Ù„Ø¢Ù†.", 'success');
        
        // Ø§Ø­Ø°Ù Ø§Ù„Ø·Ù„Ø¨
        mysqli_query($conn, "DELETE FROM requests WHERE id = $id");
        echo "<script>alert('ØªÙ…Øª Ø§Ù„Ù…ÙˆØ§ÙÙ‚Ø© Ø¹Ù„Ù‰ Ø§Ù„Ø·Ù„Ø¨ ÙˆØ¥Ø¶Ø§ÙØ© Ø§Ù„ÙƒØªØ§Ø¨.');</script>";
    }
}

if(isset($_GET['reject_request'])) {
    $id = intval($_GET['reject_request']);
